# Keep the build context (and image) small and free of secrets.
# Node deps are reinstalled inside the image from the manifests.
node_modules
npm-debug.log*

# Local-only assets the server never reads (it fetches from Google Drive)
FCU DCMP Datasheets
FCU DMP Datasheets

# Secrets are provided via Railway env vars, not files — never bake them in
.env
.env.*
# Replay captures hold real messages and Drive listings: local only
tests/replay/*.local.json
*.pem
*service-account*.json
*credentials*.json
whatsapp-bot-*.json
_temp_sa.json
_sa.json

# Local databases (DATA_DIR) never go in the image
data/

# VCS / docs / scratch
.git
.gitignore
*.md
*.log
CUsers*.txt

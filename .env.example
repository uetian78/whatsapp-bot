# ===== Copy to ".env" and fill in =====

# Password for the admin pages (/drive-index). Any username works.
# Unset = those pages return 503.
ADMIN_PASSWORD=choose_a_long_password

# Comma-separated admin WhatsApp numbers (digits). Default: 97466279059
ADMIN_NUMBERS=97466279059

# WhatsApp is OFF unless this is exactly true. When true, the three
# WhatsApp settings below (VERIFY_TOKEN, WHATSAPP_TOKEN, PHONE_NUMBER_ID) are required.
WHATSAPP_ENABLED=false

# Secret string you invent (webhook verification)
VERIFY_TOKEN=put_any_secret_here

# From Meta WhatsApp dashboard
WHATSAPP_TOKEN=your_meta_token
PHONE_NUMBER_ID=your_phone_number_id

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# The ID in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_sheet_id

# The ENTIRE service-account JSON file, pasted as ONE line.
# (From Google Cloud -> Service Account -> Keys -> Add Key -> JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com"}

PORT=3000

# Where the databases live. Locally it
# defaults to ~/.hvac-assistant (not the repo: OneDrive can corrupt SQLite). On
# Railway set it to the volume's mount path, /data. Without it, a Railway deploy
# saves inside the container and loses everything on every deploy (the app falls
# back to RAILWAY_VOLUME_MOUNT_PATH if that is set, and warns loudly if the
# folder isn't the volume).
DATA_DIR=

# Web app sign-in. WEB_SECRET signs the personal links and session cookies. It
# must be at least 32 random characters: anything shorter counts as unset and
# every /app page returns 503. Generate one, don't invent one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out and voids their links.
WEB_SECRET=
# PUBLIC_URL is the app's public address, used by scripts/make-invite.js.
PUBLIC_URL=https://your-app.up.railway.app
